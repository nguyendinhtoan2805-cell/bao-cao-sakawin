# KHÔNG cần thêm quyền wiki:* cho Lark App:
#   https://sakawinvietnam.sg.larksuite.com/wiki/<APP_TOKEN>?table=<TABLE_ID>&view=...
LARK_APP_TOKEN=HObGw4pqEi82R9kr6UflZ7sPgc0

# Bảng "Báo Cáo Doanh Thu - Kênh Bán Hàng"
LARK_TABLE_REVENUE=tblRJxoL2ImoIhmI
# TUỲ CHỌN — chỉ khai nếu bạn để Target ở một bảng RIÊNG.
# Cách mặc định (khuyên dùng): thêm cột Target ngay vào bảng doanh thu ở trên,
# khi đó KHÔNG khai biến này.
# LARK_TABLE_TARGET=tblYYYYYYYYYYYYYY
# Bảng "Báo Cáo Chi Tiết - 2026" — nguồn của trang Tài chính & Lãi lỗ
LARK_TABLE_FINANCE=tbl87Xc6y812sNBx

# Bảng "Nhận xét"                            (tuỳ chọn)
