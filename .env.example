# ============ ĐĂNG NHẬP & PHÂN QUYỀN ============
# Chuỗi ngẫu nhiên để ký phiên đăng nhập. Đổi chuỗi này = đá tất cả mọi người ra.
# Sinh bằng: openssl rand -base64 48
SESSION_SECRET=thay-bang-chuoi-ngau-nhien-that-dai

# Email quản trị viên gốc, cách nhau bằng dấu phẩy. Luôn toàn quyền kể cả khi kho
