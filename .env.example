# Vercel → Project → Settings → Environment Variables (tick cả Production/Preview/Development)
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Base "TỔNG QUAN DOANH SỐ 2026 - SAKAWIN"
LARK_APP_TOKEN=bascnXXXXXXXXXXXXXXXXXXXXXX

# Bảng "Báo Cáo Doanh Thu - Kênh Bán Hàng"  (đã có sẵn, không sửa gì)
LARK_TABLE_REVENUE=tblXXXXXXXXXXXXXX
# Bảng "Target & Kế hoạch"                   (bảng tạo mới)
LARK_TABLE_TARGET=tblYYYYYYYYYYYYYY
# Bảng "Nhận xét"                            (tuỳ chọn)
LARK_TABLE_NOTES=tblZZZZZZZZZZZZZZ

# Cột Tháng trong Base chỉ ghi 1..12 nên cần biết là năm nào
REPORT_YEAR=2026
REPORT_AUTHOR=Nguyễn Đình Toàn

# Chỉ đổi nếu công ty dùng Feishu (bản Trung Quốc): https://open.feishu.cn
LARK_HOST=https://open.larksuite.com
