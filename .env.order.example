# Order integration. Never put credentials into HTML, chat or Git.
# Set these in a private .env.order.local for local diagnostics / Vercel environment settings.
# Approved reuse of WEBAPP BC Doanh số, after verifying it matches the current LARK_APP_ID.
ORDER_USE_EXISTING_LARK_APP=true
# Leave the pair below unset when reusing existing LARK_APP_ID / LARK_APP_SECRET.
# If a different app is needed, provide BOTH; partial configuration fails closed.
# LARK_ORDER_APP_ID=
# LARK_ORDER_APP_SECRET=
LARK_ORDER_DESIGN_BASE=
LARK_ORDER_DESIGN_TABLE=tbloTVabCdgzgiU6
LARK_ORDER_MEDIA_BASE=
LARK_ORDER_MEDIA_TABLE=tbl9dYmn7jk8K0VK
LARK_ORDER_SHOOTS_TABLE=tblGOY43BeI3yZPx
# Start read-only. Turn on only after schema, access and one controlled write/readback pass.
ORDER_WRITES_ENABLED=false
# Optional verified mapping if Lark person fields do not return email.
# Open IDs MUST belong to the chosen Lark app. designName matches an existing option exactly.
# LARK_ORDER_USER_MAP=[{"email":"member@example.test","id":"ou_VERIFIED_ID","name":"Display name","designName":"Existing Design requester option"}]
# Reuse the existing server-side session and Redis lock settings, without changing their values:
# SESSION_SECRET, SITE_URL, KV_REST_API_URL, KV_REST_API_TOKEN
